# Copy to .env and set unique secrets before starting the stack.
POSTGRES_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ENCRYPTION_KEY=

# Local-only defaults. For remote access, use a public IP and open these ports.
PANEL_BIND_IP=127.0.0.1
PANEL_HTTP_PORT=8080
PANEL_HTTPS_PORT=443
PANEL_CERT_HOST=localhost
PUBLIC_ORIGIN=https://localhost:8080
COOKIE_SECURE=true

# Optional integrations
XRAY_VLESS_URI=
XRAY_ENABLED=false
MATRIX_HOMESERVER=
MATRIX_USERNAME=
MATRIX_PASSWORD=
